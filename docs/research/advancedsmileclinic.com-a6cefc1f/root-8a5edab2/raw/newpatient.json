"id":"brxe-aszauq","cls":"brxe-code","rect":{"x":20,"y":4402.2,"w":1385,"h":0},"styles":{"width":"1385px","position":"static","top":"auto","left":"auto","right":"auto","bottom":"auto","visibility":"visible"},"children":[{"tag":"style","cls":"","rect":{"x":0,"y":3870,"w":0,"h":0},"styles":{"position":"static","visibility":"visible"},"text":"#botonseemore { transition: transform 0.3s ease; } .rotado { transform: rotate(180deg); } /* Estado inicial: oculto */ .bloque { max-height: 0; opacity: 0; overflow: hidden; transition: all 0.8s ease; /* Duración y suavidad */ } /* Estado visible: se expande y aparece */ .bloque.mostrar { margin-top:60px; max-height: 800px; /* Ajusta según el contenido */ opacity: 1; }"},{"tag":"script","cls":"","rect":{"x":0,"y":3870,"w":0,"h":0},"styles":{"position":"static","visibility":"visible"},"text":"const boton = document.getElementById(\"botonseemore\"); const texto = document.getElementById(\"textob\"); const bloques = [document.getElementById(\"bloquen2\"), document.getElementById(\"bloquen3\")]; boton.addEventListener(\"click\", function() { const visible = bloques[0].classList.contains(\"mostrar\"); if (visible) { // Ocultar con animación bloques.forEach(b => b.classList.remove(\"mostrar\")); boton.classList.remove(\"rotado\"); texto.textContent = \"See More\"; } else { // Mostrar con animación bloques.forEach(b => b.classList.add(\"mostrar\")); boton.classList.add(\"rotado\"); texto.textContent = \"See Less\"; } });"}]}]}