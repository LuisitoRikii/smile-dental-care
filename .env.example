# ─────────────────────────────────────────────────────────────
# Smile Dental Care — envío del formulario de contacto (Resend)
# Copia este archivo a `.env.local` y rellena los valores.
#   cp .env.example .env.local
# `.env.local` está en .gitignore: nunca se sube a git.
# ─────────────────────────────────────────────────────────────

# Clave de API de Resend → https://resend.com/api-keys
# (empieza con "re_")
RESEND_API_KEY=

# De dónde sale el correo. En Resend el dominio DEBE estar verificado
# (https://resend.com/domains). No sirve una dirección @gmail.com como "de".
# Si esquinas 401/403, casi siempre es dominio no verificado o clave mala.
RESEND_FROM_EMAIL=hola@smiledentalcare.info
RESEND_FROM_NAME=Smile Dental Care

# A dónde llega el correo (bandeja de entrada real).
RESEND_TO_EMAIL=Smiledentalcare860@gmail.com

# Responder-a. Déjalo vacío para que al responder se conteste directamente
# a quien completó el formulario (lo recomendado).
RESEND_REPLY_TO_EMAIL=
